# Template for Lakebase/Zerobus credentials. Copy to .env (gitignored) and fill in real
# values -- never commit a filled-in copy.
#
# docker-compose.yml reads this automatically (Docker Compose's native .env support).
# test.py also reads it directly (see _load_dotenv()) when run outside Docker; values
# already set in the shell environment always take priority over this file.

# Lakebase ----------------------------------------------------------------------------
LAKEBASE_ENDPOINT=projects/<project>/branches/<branch>/endpoints/<endpoint>
# Leave unset to authenticate via DATABRICKS_HOST/DATABRICKS_TOKEN instead of a profile.
#LAKEBASE_PROFILE=
# Required -- ConnectionConfig.from_environ() raises KeyError if this is unset.
LAKEBASE_DATABASE=databricks_postgres

# Zerobus -------------------------------------------------------------------------------
ZEROBUS_WORKSPACE_ID=<workspace id>
ZEROBUS_REGION=us-east-2
# Leave unset to authenticate via DATABRICKS_CLIENT_ID/DATABRICKS_CLIENT_SECRET instead
# of a profile -- Zerobus always needs service-principal (OAuth M2M) credentials.
#ZEROBUS_PROFILE=
# Required -- ConnectionConfig.from_environ() raises KeyError if either is unset.
ZEROBUS_CATALOG=main
ZEROBUS_SCHEMA=blf

# Shared workspace auth (PAT for Lakebase, host for both) -----------------------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Service-principal M2M credentials for Zerobus (only needed when ZEROBUS_PROFILE
# is unset)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
